// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum ReportType {
  LOST
  FOUND
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  OTHER
}

enum ReportStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  phone         String?

  reports       Report[]
  contacts      Contact[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

model Report {
  id              String       @id @default(cuid())

  type            ReportType
  species         PetSpecies
  description     String       @db.Text
  imageUrl        String
  contactInfo     String

  locationRef     String?

  realLat         Float
  realLng         Float
  publicLat       Float
  publicLng       Float

  petName         String?
  reward          Boolean      @default(false)
  rewardAmount    Float?

  status          ReportStatus @default(ACTIVE)

  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastActivityAt  DateTime     @default(now())

@@index([status, createdAt])
@@index([userId, createdAt])
@@index([publicLat, publicLng])
}

model Contact {
  id          String   @id @default(cuid())

  message     String   @db.Text
  senderEmail String
  senderName  String?

  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  read        Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id])
  userId   String

  @@index([reportId])
  @@index([createdAt])
}